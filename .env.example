# =====================================================================
# MCP Gateway configuration (TSD Section 14)
#
# On the server this file lives at /opt/mcp/.env, mode 600, root-owned.
# Never commit a filled-in copy: .gitignore excludes .env (S5).
#
# Every value is validated at boot. In production the process REFUSES TO START if
# a secret is missing, a placeholder, or if KLIP_ENV disagrees with KLIP_BASE_URL.
# =====================================================================

NODE_ENV=production
PORT=8787
LOG_LEVEL=info

# --- Public identity -------------------------------------------------
# Used as the OAuth issuer, and as the base of the RFC 8707 canonical resource
# identifier (<PUBLIC_URL>/mcp) that access tokens are audience-bound to.
PUBLIC_URL=https://<gateway-hostname>

# --- Database --------------------------------------------------------
# POSTGRES_PASSWORD is consumed by the db container; DATABASE_URL by the gateway.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://gateway:CHANGE_ME@db:5432/gateway

# --- KLIP ------------------------------------------------------------
# KLIP_ENV appears in every tool result and every audit row, so a staging answer
# can never claim to have come from production (review H7).
# Stage 7 cutover = change BOTH of the next two lines together.
KLIP_ENV=staging
KLIP_BASE_URL=http://<klip-backend-private-ip>:5001/api

KLIP_SVC_USER=svc-mcp@example.com
KLIP_SVC_PASS=
KLIP_TIMEOUT_MS=15000

# Bounded page walker (TSD 7.3).
# KLIP_PAGE_SIZE must not exceed the maximum `limit` KLIP actually accepts -
# determine it during P1 reconciliation. If KLIP silently clamps to 100, leaving
# this at 1000 turns one page into ten and breaks the latency target (review H5).
KLIP_MAX_PAGES=10
KLIP_PAGE_SIZE=100
KLIP_FETCH_CONCURRENCY=4

# Short-lived read cache in seconds; 0 disables it. A cached result reports its
# original fetch time as as_of, so staleness stays visible.
CACHE_TTL_SECONDS=60

# --- Downstream Hub OIDC (primary login path) ------------------------
# The Hub authenticates the human. The gateway's users table remains the pilot
# ALLOWLIST: a Hub account that is not on it is refused (review H2 / H8), which
# keeps the <=15 pilot cap and Q4's vetting meaningful.
#
# Only the issuer plus client credentials are needed - authorize/token/jwks are all
# read from the Hub's own /.well-known/openid-configuration.
#
# Register THIS redirect URI with the Hub:   <PUBLIC_URL>/authorize/hub/callback
# Verify the whole thing before pilot users try:
#   docker compose exec -T gateway node dist/cli.js hub:check
# DWS Hub is a PUBLIC client using PKCE: there is NO client secret, and its OIDC
# endpoints live under /api/sso, so the discovery document is NOT at the RFC 8414
# path derived from the issuer. Both facts are why HUB_DISCOVERY_URL is explicit.
HUB_ISSUER=https://<hub-host>
HUB_DISCOVERY_URL=https://<hub-host>/api/sso/.well-known/openid-configuration
HUB_CLIENT_ID=mcp-gw
# HUB_CLIENT_SECRET=   <-- LEAVE UNSET for DWS Hub. No secret exists.

# DWS Hub advertises only openid, profile and email. Do NOT add `groups`: it is not
# advertised, no groups claim is issued, and HUB_REQUIRED_GROUP would then refuse
# every user.
HUB_SCOPES=openid email profile

# Claim names, if the Hub differs from the OIDC defaults.
HUB_EMAIL_CLAIM=email
HUB_GROUPS_CLAIM=groups

# How client credentials are presented at the token endpoint. Read from discovery
# (DWS Hub advertises "none"); set only if the metadata is wrong.
#   client_secret_basic | client_secret_post | none
# HUB_TOKEN_AUTH_METHOD=

# Token request body encoding. DWS Hub requires JSON and answers
# `unsupported_grant_type` to a form-encoded body - note that error names the grant
# type, not the encoding, so it misleads. Falls back to the other on that exact error.
HUB_TOKEN_BODY=json

# Optional second gate: require this group in the Hub token before admitting anyone.
# Lets pilot membership be managed centrally in the Hub as well as here.
HUB_REQUIRED_GROUP=

# How long a Hub round trip may take before its single-use state row expires.
HUB_STATE_TTL_SECONDS=600

# The local password path, for exactly ONE break-glass account. Set false once the
# Hub path is proven in production, to remove the password surface entirely.
BREAK_GLASS_ENABLED=true

# Human-readable logs. Deliberately NOT keyed on NODE_ENV: pino-pretty is a
# devDependency, so a production image that tried to load it crash-looped at import.
LOG_PRETTY=false

# --- OAuth -----------------------------------------------------------
OAUTH_SIGNING_KEY_PATH=/app/secrets/oauth_signing.pem
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_CODE_TTL_SECONDS=60

# Registered redirect_uris must sit on one of these origins (T-8).
ALLOWED_REDIRECT_ORIGINS=https://claude.ai,https://claude.com

# Browser origins accepted on /mcp when an Origin header is present. An ABSENT
# Origin is always allowed: Claude calls the connector server-to-server and may
# send none, so rejecting absent would 403 every tool call (review B3).
ALLOWED_ORIGINS=https://claude.ai,https://claude.com

# Per-user token bucket, keyed on the OAuth subject rather than the client IP -
# all traffic arrives from Anthropic's shared egress range (review B7).
RATE_LIMIT_USER=30/300s

# --- Backups ---------------------------------------------------------
BACKUP_DIR=/opt/backups/mcp-gateway
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR=18
